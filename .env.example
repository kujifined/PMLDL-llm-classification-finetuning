# ClearML Hosted Service. Copy this file to .env and fill secrets locally.
# Never commit a populated .env or clearml.conf file.
CLEARML_API_HOST=https://api.clear.ml
CLEARML_WEB_HOST=https://app.clear.ml
CLEARML_FILES_HOST=https://files.clear.ml
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=

# Use 1 for internet-disabled Kaggle runs and import the offline session later.
CLEARML_OFFLINE_MODE=0
